ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
DEVICE_SESSION_EXPIRES_IN=90d
COOKIE_DOMAIN=
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
FILE_UPLOAD_MAX_BYTES=10000000
BOOTSTRAP_SETUP_TOKEN=
S3_ENDPOINT=
