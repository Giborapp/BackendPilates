NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://pilates:pilates@localhost:5432/pilates_manager?schema=public"
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters-access
