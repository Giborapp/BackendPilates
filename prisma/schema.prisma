generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudioStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum Role {
  ADMIN
  PROFESSIONAL
  RECEPTION
  FINANCE
  CUSTOM
}

enum JustifiedAbsencePeriod {
  CALENDAR_MONTH
  PLAN_CYCLE
}

enum StudentStatus {
  LEAD
  TRIAL
  ACTIVE
  PAUSED
  INACTIVE
  ARCHIVED
}

enum TrialStatus {
  NEW_CONTACT
  TRIAL_SCHEDULED
  CONFIRMED
  ATTENDED
  MISSED
  INTERESTED
  CONVERTED
  NOT_CONVERTED
}

enum StudentPlanStatus {
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  WAIVED
}

enum PaymentMethod {
  PIX
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingType {
  FIXED
  REPLACEMENT
  TRIAL
  EXTRA
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED_ABSENCE
  CANCELLED_IN_TIME
  CANCELLED_LATE
  CANCELLED_BY_STUDIO
}

enum ReplacementCreditStatus {
  AVAILABLE
  RESERVED
  USED
  EXPIRED
  CANCELLED
}

enum WaitingListStatus {
  WAITING
  OFFERED
  BOOKED
  CANCELLED
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
  AMENDED
}

enum FileOwnerType {
  STUDENT
  STAFF
  ASSESSMENT
}

model Studio {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  slug         String          @unique
  email        String          @unique
  passwordHash String
  phone        String?
  timezone     String          @default("America/Sao_Paulo")
  locale       String          @default("pt-BR")
  currency     String          @default("BRL")
  status       StudioStatus    @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  settings     StudioSettings?
  units        Unit[]
  staff        StaffMember[]
  devices      DeviceSession[]

  @@index([email])
}

model StudioSettings {
  studioId                               String                 @id @db.Uuid
  defaultClassCapacity                   Int                    @default(6)
  cancellationNoticeHours                Int                    @default(12)
  maxJustifiedAbsences                   Int                    @default(1)
  justifiedAbsencePeriod                 JustifiedAbsencePeriod @default(CALENDAR_MONTH)
  replacementCreditValidityDays          Int                    @default(30)
  allowCreditCarryOver                   Boolean                @default(false)
  requireJustificationText               Boolean                @default(true)
  requireAdminApprovalForJustification   Boolean                @default(false)
  allowReplacementWithOtherProfessional  Boolean                @default(true)
  allowReplacementAtOtherTime            Boolean                @default(true)
  allowReplacementAtOtherUnit            Boolean                @default(true)
  replacementNoShowConsumesCredit        Boolean                @default(true)
  allowOverbooking                       Boolean                @default(false)
  trialClassOccupiesCapacity             Boolean                @default(true)
  automaticWaitingList                   Boolean                @default(true)
  createdAt                              DateTime               @default(now())
  updatedAt                              DateTime               @updatedAt
  studio                                 Studio                 @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  studioId  String   @db.Uuid
  name      String
  street    String?
  number    String?
  district  String?
  city      String?
  state     String?
  zipCode   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  rooms     Room[]
  schedules RecurringClassSchedule[]

  @@index([studioId])
}

model Room {
  id              String                   @id @default(uuid()) @db.Uuid
  studioId        String                   @db.Uuid
  unitId          String                   @db.Uuid
  name            String
  defaultCapacity Int                      @default(6)
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  unit            Unit                     @relation(fields: [unitId], references: [id])
  schedules       RecurringClassSchedule[]

  @@index([studioId, unitId])
}

model StaffMember {
  id               String                   @id @default(uuid()) @db.Uuid
  studioId         String                   @db.Uuid
  name             String
  photoUrl         String?
  role             Role                     @default(PROFESSIONAL)
  pinHash          String
  pinLookupHash    String
  permissions      String[]                 @default([])
  active           Boolean                  @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  archivedAt       DateTime?
  studio           Studio                   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  refreshSessions  RefreshSession[]
  createdBookings  ClassBooking[]           @relation("BookingCreator")
  markedAttendance Attendance[]             @relation("AttendanceMarker")
  schedules        RecurringClassSchedule[]
  sessions         ClassSession[]

  @@unique([studioId, pinLookupHash])
  @@index([studioId, active])
}

model DeviceSession {
  id         String    @id @default(uuid()) @db.Uuid
  studioId   String    @db.Uuid
  tokenHash  String    @unique
  name       String?
  userAgent  String?
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  studio     Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  refreshes  RefreshSession[]

  @@index([studioId, revokedAt])
}

model RefreshSession {
  id              String         @id @default(uuid()) @db.Uuid
  studioId        String         @db.Uuid
  staffMemberId   String         @db.Uuid
  deviceSessionId String         @db.Uuid
  tokenHash       String         @unique
  replacedById    String?        @db.Uuid
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  lastUsedAt      DateTime       @default(now())
  staffMember     StaffMember    @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  deviceSession   DeviceSession  @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)

  @@index([studioId, staffMemberId, revokedAt])
}

model Student {
  id                    String                 @id @default(uuid()) @db.Uuid
  studioId              String                 @db.Uuid
  fullName              String
  preferredName         String?
  photoUrl              String?
  email                 String?
  phone                 String?
  birthDate             DateTime?              @db.Date
  emergencyContactName  String?
  emergencyContactPhone String?
  startDate             DateTime?              @db.Date
  status                StudentStatus          @default(LEAD)
  monthlyLessonLimit    Int                    @default(0)
  generalNotes          String?
  importantCareNotes    String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archivedAt            DateTime?
  trials                TrialProcess[]
  plans                 StudentPlan[]
  payments              Payment[]
  bookings              ClassBooking[]
  credits               ReplacementCredit[]
  assessments           Assessment[]

  @@index([studioId, status])
}

model TrialProcess {
  id                 String       @id @default(uuid()) @db.Uuid
  studioId           String       @db.Uuid
  studentId          String       @db.Uuid
  source             String?
  responsibleStaffId String?      @db.Uuid
  status             TrialStatus  @default(NEW_CONTACT)
  scheduledSessionId String?      @db.Uuid
  notes              String?
  convertedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  student            Student      @relation(fields: [studentId], references: [id])

  @@index([studioId, status])
}

model Plan {
  id                String        @id @default(uuid()) @db.Uuid
  studioId          String        @db.Uuid
  name              String
  description       String?
  sessionsPerWeek   Int
  defaultAmount     Decimal       @db.Decimal(12, 2)
  defaultBillingDay Int
  durationMonths    Int?
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  studentPlans      StudentPlan[]

  @@index([studioId, active])
}

model StudentPlan {
  id         String            @id @default(uuid()) @db.Uuid
  studioId   String            @db.Uuid
  studentId  String            @db.Uuid
  planId     String            @db.Uuid
  amount     Decimal           @db.Decimal(12, 2)
  billingDay Int
  startDate  DateTime          @db.Date
  endDate    DateTime?         @db.Date
  status     StudentPlanStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  student    Student           @relation(fields: [studentId], references: [id])
  plan       Plan              @relation(fields: [planId], references: [id])
  payments   Payment[]

  @@index([studioId, studentId, status])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  studioId      String        @db.Uuid
  studentId     String        @db.Uuid
  studentPlanId String?       @db.Uuid
  referenceMonth DateTime     @db.Date
  dueDate       DateTime      @db.Date
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  student       Student       @relation(fields: [studentId], references: [id])
  studentPlan   StudentPlan?  @relation(fields: [studentPlanId], references: [id])

  @@index([studioId, status, dueDate])
}

model RecurringClassSchedule {
  id              String         @id @default(uuid()) @db.Uuid
  studioId        String         @db.Uuid
  unitId          String         @db.Uuid
  roomId          String         @db.Uuid
  professionalId  String         @db.Uuid
  weekday         Weekday
  startTime       String
  durationMinutes Int
  capacity        Int
  startsOn        DateTime       @db.Date
  endsOn          DateTime?      @db.Date
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?
  unit            Unit           @relation(fields: [unitId], references: [id])
  room            Room           @relation(fields: [roomId], references: [id])
  professional    StaffMember    @relation(fields: [professionalId], references: [id])
  sessions        ClassSession[]

  @@index([studioId, active, weekday])
}

model ClassSession {
  id                  String                  @id @default(uuid()) @db.Uuid
  studioId            String                  @db.Uuid
  recurringScheduleId String?                 @db.Uuid
  unitId              String                  @db.Uuid
  roomId              String                  @db.Uuid
  professionalId      String                  @db.Uuid
  startsAt            DateTime
  endsAt              DateTime
  capacity            Int
  status              ClassSessionStatus      @default(SCHEDULED)
  cancellationReason  String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  recurringSchedule   RecurringClassSchedule? @relation(fields: [recurringScheduleId], references: [id])
  professional        StaffMember             @relation(fields: [professionalId], references: [id])
  bookings            ClassBooking[]
  waitingList         WaitingListEntry[]

  @@index([studioId, startsAt, status])
}

model ClassBooking {
  id                  String             @id @default(uuid()) @db.Uuid
  studioId            String             @db.Uuid
  classSessionId      String             @db.Uuid
  studentId           String             @db.Uuid
  bookingType         BookingType
  status              BookingStatus      @default(BOOKED)
  replacementCreditId String?            @unique @db.Uuid
  createdByStaffId    String?            @db.Uuid
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  classSession        ClassSession       @relation(fields: [classSessionId], references: [id])
  student             Student            @relation(fields: [studentId], references: [id])
  replacementCredit   ReplacementCredit? @relation("CreditBooking", fields: [replacementCreditId], references: [id])
  createdByStaff      StaffMember?       @relation("BookingCreator", fields: [createdByStaffId], references: [id])
  attendance          Attendance?

  @@unique([studioId, classSessionId, studentId])
  @@index([studioId, classSessionId, status])
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  studioId       String           @db.Uuid
  classBookingId String           @unique @db.Uuid
  status         AttendanceStatus
  justification  String?
  markedByStaffId String?         @db.Uuid
  markedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  classBooking   ClassBooking     @relation(fields: [classBookingId], references: [id])
  markedByStaff  StaffMember?     @relation("AttendanceMarker", fields: [markedByStaffId], references: [id])
  credit         ReplacementCredit?

  @@index([studioId, status])
}

model ReplacementCredit {
  id                 String                  @id @default(uuid()) @db.Uuid
  studioId           String                  @db.Uuid
  studentId          String                  @db.Uuid
  sourceAttendanceId String?                 @unique @db.Uuid
  status             ReplacementCreditStatus @default(AVAILABLE)
  grantedAt          DateTime                @default(now())
  expiresAt          DateTime
  usedAt             DateTime?
  usedBookingId      String?                 @unique @db.Uuid
  approvedByStaffId  String?                 @db.Uuid
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  student            Student                 @relation(fields: [studentId], references: [id])
  sourceAttendance   Attendance?             @relation(fields: [sourceAttendanceId], references: [id])
  usedBooking        ClassBooking?           @relation("CreditBooking")

  @@index([studioId, studentId, status])
}

model WaitingListEntry {
  id             String            @id @default(uuid()) @db.Uuid
  studioId       String            @db.Uuid
  classSessionId String            @db.Uuid
  studentId      String            @db.Uuid
  position       Int
  status         WaitingListStatus @default(WAITING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  classSession   ClassSession      @relation(fields: [classSessionId], references: [id])

  @@unique([studioId, classSessionId, studentId])
  @@index([studioId, classSessionId, status])
}

model AssessmentTemplate {
  id               String       @id @default(uuid()) @db.Uuid
  studioId         String       @db.Uuid
  name             String
  description      String?
  version          Int          @default(1)
  fields           Json
  active           Boolean      @default(true)
  createdByStaffId String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  archivedAt       DateTime?
  assessments      Assessment[]

  @@unique([studioId, name, version])
  @@index([studioId, active])
}

model Assessment {
  id               String              @id @default(uuid()) @db.Uuid
  studioId         String              @db.Uuid
  studentId        String              @db.Uuid
  templateId       String              @db.Uuid
  templateVersion  Int
  answers          Json
  status           AssessmentStatus    @default(DRAFT)
  performedByStaffId String?           @db.Uuid
  completedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  student          Student             @relation(fields: [studentId], references: [id])
  template         AssessmentTemplate  @relation(fields: [templateId], references: [id])

  @@index([studioId, studentId, status])
}

model FileAsset {
  id                String        @id @default(uuid()) @db.Uuid
  studioId          String        @db.Uuid
  uploadedByStaffId String?       @db.Uuid
  ownerType         FileOwnerType
  ownerId           String        @db.Uuid
  storageKey        String
  mimeType          String
  size              Int
  createdAt         DateTime      @default(now())
  deletedAt         DateTime?

  @@index([studioId, ownerType, ownerId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  studioId     String   @db.Uuid
  actorStaffId String?  @db.Uuid
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([studioId, createdAt])
  @@index([studioId, entityType, entityId])
}
